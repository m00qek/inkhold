# Nightly Inkhold backup: one snapshot into BACKUP_DIR, then a quick check of
# it. Started by inkhold-backup.timer; run it by hand with
#   systemctl start inkhold-backup
#
# Edit before enabling (or use `systemctl edit inkhold-backup`):
#   - User=/Group= : the account that runs the server and owns its state
#   - --config=    : the server's config file
#   - BACKUP_DIR   : an existing folder, best on another disk (NAS, USB, a
#                    synced cloud folder): a backup on the same disk goes
#                    down with it
#
# Not needed in Docker: the image schedules its own backups when a folder is
# mounted at /backup (README, "Back up your notes").
#
# The admin screen shows the result of every run, so a failure is seen even
# when nobody reads the journal.

[Unit]
Description=Inkhold backup
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=inkhold
Group=inkhold
Environment=BACKUP_DIR=/mnt/nas/inkhold
ExecStart=/usr/local/bin/inkhold --config=/etc/inkhold/config.zon backup create ${BACKUP_DIR} --keep=7
ExecStartPost=/usr/local/bin/inkhold --config=/etc/inkhold/config.zon backup verify ${BACKUP_DIR}
# The backup lowers its own priority; these repeat it for whatever it starts.
Nice=19
IOSchedulingClass=idle
CPUWeight=idle
