// Inkhold's settings. Copy to config.zon and edit. Every setting is optional:
// one left out takes the value shown here. The comment above each one is what
// the docs' "config.zon settings" page shows, so keep them for the person who
// runs the server.
.{
    // The address to listen on. The default accepts this computer only: use
    // "0.0.0.0" for every network it is on, or one of its addresses.
    .host = "127.0.0.1",

    // The port for everything: the tablet's sync, the browser app and HTTPS.
    .port = 8089,

    // The database file, created on the first start.
    .db_path = "inkhold.db",

    // The key that encrypts stored credentials, created on the first start.
    // Kept apart from the database, so a stolen database reveals nothing. Back
    // it up somewhere else: without it, everyone has to reset their password.
    .cred_key_path = "cred.key",

    // Where your notebooks and everything derived from them are stored.
    .data_dir = "data",

    // The browser app's files. Empty serves no browser app, only the tablet's
    // sync.
    .web_dir = "webapp/dist",

    // The email of the first account, created on the first start with a
    // temporary password. It must be an email address, and it applies on the
    // first start only.
    .admin_email = "admin@home.lan",

    // How many connections may be open at once. An idle one costs about 34 KB
    // and no thread, and a browser keeps about 6 per tab.
    .max_connections = 192,

    // Threads answering requests. Memory grows with this number; a few are
    // plenty for a household.
    .workers = 4,

    // Threads for the live updates that browsers and tablets listen to, beyond
    // the workers.
    .max_held = 24,

    // Seconds an idle connection stays open. Generous, because over HTTPS
    // reopening one costs a handshake.
    .idle_timeout_s = 300,

    // The address of a reverse proxy that handles HTTPS in front of Inkhold.
    // Requests from it are rate-limited by each visitor's address (from
    // X-Real-IP, or the last X-Forwarded-For) instead of all as one. Empty
    // trusts no such header.
    .trusted_proxy = "",

    // Admins see a notice in the library when the newest successful backup is
    // older than this many hours.
    .backup_warn_after_hours = 48,

    // Sync the tablet's To-Do lists and tasks. New, so off: while off, the
    // tablet's To-Do app shows a sync error and nothing is touched. Copy the
    // tablet first, and when it asks how to treat its digest and to-do data,
    // choose "Retain locally".
    .todo_sync = false,

    .tls = .{
        // Serve HTTPS (TLS 1.3) directly, with no reverse proxy. When false,
        // plain HTTP.
        .enabled = false,
        // The certificate, as a PEM file.
        .cert_path = "certs/cert.pem",
        // Its private key, as a PEM file.
        .key_path = "certs/key.pem",
        // The cipher suites allowed, preferred first. Leave it empty: Inkhold
        // then picks what is cheap on its own processor. Names such as
        // "AES_256_GCM_SHA384", "AES_128_GCM_SHA256", "CHACHA20_POLY1305_SHA256".
        .cipher_suites = .{},
    },
}
