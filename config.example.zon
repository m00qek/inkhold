// Inkhold server config. Copy to config.zon and edit.
// All fields are optional; omitted ones use the defaults shown here.
.{
    .host = "127.0.0.1",
    .port = 8089,

    // SQLite database file (created if absent). ":memory:" for an ephemeral db.
    .db_path = "inkhold.db",

    // 32-byte credential-encryption key, held OUTSIDE the db (ideally outside the
    // backup path too) so a stolen inkhold.db yields no recoverable credentials.
    // Generated + persisted 0600 on first run if absent. BACK THIS UP: losing it
    // makes every stored credential unrecoverable → forced resets. See docs/design/auth.md.
    .cred_key_path = "cred.key",

    // Directory for the content-addressed blob store and render cache.
    .data_dir = "data",

    // Path to the built web SPA (dist/) to serve as static files. Empty disables
    // static serving (404 on any non-API route). When set, this same process
    // serves the browser UI alongside the device sync API — one port for everything.
    .web_dir = "webapp/dist",

    // Email/login of the auto-created first-run administrator.
    .admin_email = "admin@home.lan",

    // Open sockets at once: parked keep-alives, requests in flight and held
    // streams. A parked socket costs ~34 KB and no thread (a browser parks ~6
    // per tab), so this is a file-descriptor budget more than a memory one.
    .max_connections = 192,

    // Threads serving requests. Everything past `db_lock` is serialised anyway,
    // so a few are plenty; memory follows this number, not the socket count.
    .workers = 4,

    // Threads for held streams (the live-update channel), beyond the workers.
    .max_held = 24,

    // A keep-alive socket idle this long is closed; the browser reopens one on
    // the next click. Generous, because under TLS a reopen is a handshake.
    .idle_timeout_s = 300,

    // Behind ONE reverse proxy that terminates TLS, its address. Requests from
    // that peer are rate-limited by the client in `X-Real-IP` (else the last
    // `X-Forwarded-For` hop) instead of by the proxy, which would otherwise
    // give every client a single shared bucket. Empty trusts no such header.
    .trusted_proxy = "",

    // Admins see a notice in the library when the newest successful
    // `inkhold backup create` (any directory) is older than this.
    .backup_warn_after_hours = 48,

    // Sync the tablet's To-Do lists and tasks. Experimental, so off: while off,
    // the tablet's To-Do app shows a sync error and nothing is touched. Before
    // turning it on, copy the tablet first and, when a tablet asks how to treat
    // its digest and to-do data at sign-in, choose "Retain locally".
    .todo_sync = false,

    .tls = .{
        // Terminate TLS in-process. When false, plaintext HTTP is served.
        .enabled = false,
        .cert_path = "certs/cert.pem",
        .key_path = "certs/key.pem",
        // Allowed TLS 1.3 cipher suites, preferred first. Empty = library default.
        // Names match tls.zig's CipherSuite enum, e.g.:
        //   "AES_256_GCM_SHA384", "AES_128_GCM_SHA256", "CHACHA20_POLY1305_SHA256"
        .cipher_suites = .{},
    },
}
